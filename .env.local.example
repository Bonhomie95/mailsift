# Copy to .env.local and fill in. The app runs WITHOUT these (seed rules only),
# but you need them for admin-added providers to persist.

# --- Admin (password-gated /admin) ---
# Required to log into /admin and add providers.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Used to sign the admin session cookie. Rotate to log everyone out.
ADMIN_SECRET=some-long-random-string

# --- Supabase (provider persistence + persistent DNS cache) ---
# Server-side only. Never expose the service-role key to the browser.
# Use the SECRET service_role key (sb_secret_...), NOT the publishable one.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Rate limiting (optional but recommended for production) ---
# Without these, rate limiting falls back to per-instance in-memory counters.
# Create a free Upstash Redis DB and paste its REST URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Adsterra ads (public — safe to expose) ---
# Banner ad keys from your Adsterra dashboard (one per banner unit/size).
NEXT_PUBLIC_ADSTERRA_BANNER1_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER2_KEY=
# Only change if Adsterra gives you a different invoke host for banners.
NEXT_PUBLIC_ADSTERRA_INVOKE_HOST=www.highperformanceformat.com
# Popunder/Social Bar invoke.js URL (e.g. //pl123456.effectivegatecpm.com/xx/yy/zz/invoke.js)
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=

# --- Sentry (optional error monitoring) ---
# Leave blank to disable. DSN is safe to expose (it's a public key).
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (keep secret).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
